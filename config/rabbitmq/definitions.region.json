  "permissions": [
    {
      "user": "admin",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    },
    {
      "user": "device",
      "vhost": "/",
      "configure": "^mqtt-subscription-.*$",
      "write": "^amq\\.topic$",
      "read": "^mqtt-subscription-.*$"
    },
    {
      "user": "telegraf",
      "vhost": "/",
      "configure": "^$",
      "write": "^telemetry\\.q$",
      "read": "^(telemetry\\.q|amq\\.topic)$"
    },
    { "user": "admin", "vhost": "eu", "configure": ".*", "write": ".*", "read": ".*" },
    {
      "user": "device-eu",
      "vhost": "eu",
      "configure": "^mqtt-subscription-.*$",
      "write": "^amq\\.topic$",
      "read": "^mqtt-subscription-.*$"
    },
    {
      "user": "telegraf-eu",
      "vhost": "eu",
      "configure": "^$",
      "write": "^$",
      "read": "^(telemetry\\.eu\\.q|amq\\.topic)$"
    },
    { "user": "admin", "vhost": "us", "configure": ".*", "write": ".*", "read": ".*" },
    {
      "user": "device-us",
      "vhost": "us",
      "configure": "^mqtt-subscription-.*$",
