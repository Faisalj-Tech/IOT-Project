      "user": "telegraf-us",
      "vhost": "us",
      "configure": "^$",
      "write": "^$",
      "read": "^(telemetry\\.us\\.q|amq\\.topic)$"
    }
  ],
  "topic_permissions": [
    {
      "user": "device-eu",
      "vhost": "eu",
      "exchange": "amq.topic",
      "write": "^region\\.eu\\..*",
      "read": "^region\\.eu\\..*"
    },
    {
      "user": "device-us",
      "vhost": "us",
      "exchange": "amq.topic",
      "write": "^region\\.us\\..*",
      "read": "^region\\.us\\..*"
    }
  ],
  "exchanges": [
    {
      "name": "dlx",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "dlx",
      "vhost": "eu",
