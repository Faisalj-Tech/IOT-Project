  "policies": [
    {
      "vhost": "eu",
      "name": "eu-limits",
      "pattern": "^telemetry\\.",
      "apply-to": "queues",
      "priority": 0,
      "definition": { "message-ttl": 604800000, "max-length": 100000 }
    },
    {
      "vhost": "us",
      "name": "us-limits",
      "pattern": "^telemetry\\.",
      "apply-to": "queues",
      "priority": 0,
      "definition": { "message-ttl": 86400000, "max-length": 10000 }
    }
  ],
  "parameters": [],
  "global_parameters": [
    {
      "name": "mqtt_port_to_vhost_mapping",
      "value": { "1893": "eu", "1993": "us" }
