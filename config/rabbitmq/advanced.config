%% Phase 5. The COMPLETE ssl_options block lives here, not split with
%% rabbitmq.conf. advanced.config REPLACES the generated ssl_options rather than
%% merging with it: setting only crl_check/crl_cache here drops cacertfile,
%% certfile and keyfile, and the broker dies at boot with
%%   {listen_error,{acceptor,{0,0,0,0,0,0,0,0},8883},no_cert}
%% (spec 2.5). crl_cache has no rabbitmq.conf key, which is why any of this is
%% in an Erlang term file at all.
%%
%% crl_check = peer without the http cache below rejects EVERY certificate with
%% {bad_crls,no_relevant_crls}, revoked or not, because the default cache does
%% not fetch (spec 2.4).
[
  {rabbit, [
    {ssl_options, [
      {cacertfile, "/certs/rootCA.crt"},
      {certfile,   "/certs/server.crt"},
      {keyfile,    "/certs/server.key"},
      {verify,     verify_peer},
      {fail_if_no_peer_cert, true},
      {crl_check,  peer},
      {crl_cache,  {ssl_crl_cache, {internal, [{http, 5000}]}}}
    ]}
  ]}
].
