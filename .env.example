# Dev-only credentials. Never reuse outside this project.
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=adminpass
RABBITMQ_DEVICE_USER=device
RABBITMQ_DEVICE_PASSWORD=devicepass
RABBITMQ_TELEGRAF_USER=telegraf
RABBITMQ_TELEGRAF_PASSWORD=telegrafpass

INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=influxadminpass
INFLUXDB_ORG=iot
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=dev-token-0123456789abcdef

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafanapass

# Shared across all cluster nodes; Erlang refuses to cluster without a match.
# Dev-only value, same status as the credentials above.
RABBITMQ_ERLANG_COOKIE=dev-cluster-cookie-change-me
# ignore | pause_minority — Phase 3 measures both (spec 5.H, 5.I).
RABBITMQ_PARTITION_HANDLING=ignore
